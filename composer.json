{
    "name": "bkp/helpdesk-ict",
    "description": "Sistem Helpdesk & Pengurusan Permohonan ICT BKP",
    "type": "project",
    "license": "proprietary",
    "authors": [
        {
            "name": "ICT BKP",
            "email": "ict@bkp.gov.my"
        }
    ],
    "require": {
        "php": ">=8.2"
    },
    "autoload": {
        "psr-4": {
            "App\\Controllers\\": "app/controllers/",
            "App\\Core\\": "app/core/",
            "App\\Repositories\\": "app/repositories/",
            "App\\Services\\": "app/services/",
            "App\\Storage\\": "app/storage/",
            "App\\ViewModels\\": "app/viewmodels/"
        },
        "files": [
            "app/core/Helper.php"
        ]
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    }
}
